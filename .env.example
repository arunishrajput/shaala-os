# Copy to .env and fill in. Never commit .env — see .gitignore.
# CLAUDE.md rule 5: secrets and model IDs live here, never hardcoded in source.

# --- Database ---
# Local (docker-compose): matches the postgres service below.
# Prod (Render): set to the Neon connection string via Render's env UI, not here.
DATABASE_URL=postgresql+psycopg://shaala:shaala@db:5432/shaala
POSTGRES_USER=shaala
POSTGRES_PASSWORD=shaala
POSTGRES_DB=shaala

# --- Auth ---
JWT_SECRET=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Vision provider (Phase 3) ---
# fixture = replay cached responses from fixtures/responses/, no network, no key needed.
# gemini  = real calls; requires GEMINI_API_KEY and GEMINI_MODEL_ID below.
VISION_PROVIDER=fixture
GEMINI_API_KEY=
# Verified against https://ai.google.dev/gemini-api/docs/latest-model at Phase 3
# kickoff (2026-08-06) — GA, multimodal, production-ready. Re-verify before
# changing; never guess a model ID (CLAUDE.md rule 4).
GEMINI_MODEL_ID=gemini-3.6-flash

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Solver (Phase 2) ---
# CP-SAT time budget per /timetable/generate call. 8s is comfortable on normal
# dev/CI hardware (see docs/solver.md). Free-tier deploy hosts can be CPU-
# constrained enough to need more — raise this in that environment's own env
# vars, not here, if generates start returning status=UNKNOWN.
SOLVER_TIME_LIMIT_S=8.0

# --- Misc ---
ENV=development

# --- Demo reset protection ---
# Required by POST /demo/reset. Add this value to GitHub Actions Secrets too
# (Settings → Secrets → Actions → DEMO_RESET_KEY) so the hourly reset works.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEMO_RESET_KEY=replace-with-a-real-random-key
